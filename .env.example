# ========================================
# Email AI Agent — Environment Configuration
# ========================================
# Copy this file to .env and fill in your values (or run: npm run setup)

# --- LLM Configuration ---
# Provider: gemini | openai | anthropic | groq | ollama | custom
LLM_PROVIDER=gemini
# Model name (provider-specific)
# Gemini: gemma-4-31b-it (default here), gemma-3-27b-it, gemini-2.0-flash, gemini-1.5-pro
# OpenAI: gpt-4o, gpt-4o-mini | Anthropic: claude-sonnet-4-20250514
# Groq: llama-3.1-70b-versatile
LLM_MODEL=gemma-4-31b-it
# API Key for the chosen LLM provider (the shared Gemini key, for now)
LLM_API_KEY=
# Optional: Custom base URL (LiteLLM proxy, Ollama, etc.)
# LLM_BASE_URL=http://localhost:11434/v1
# Optional generation controls.
# NOTE: gemma-4-31b-it is a "thinking" model — it spends hidden reasoning tokens
# before its answer, so keep this budget generous (>=2048) or JSON replies get cut
# off. The categorizer/summarizer already request 2048 explicitly; this is the floor
# for anything that doesn't.
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.3

# --- Gmail ---
# The orchestrator launches a Gmail MCP server (default @gongrzhe/server-gmail-autoauth-mcp).
# Complete Gmail OAuth per docs/GMAIL-SETUP.md. GMAIL_CLIENT_ID is optional here.
GMAIL_EMAIL=
GMAIL_DISPLAY_NAME=Gmail
# GMAIL_ACCOUNT_ID=gmail-primary
# GMAIL_CLIENT_ID=
# Override the launcher if using a different Gmail MCP server:
# GMAIL_MCP_COMMAND=npx
# GMAIL_MCP_ARGS=["-y","@gongrzhe/server-gmail-autoauth-mcp"]

# --- Zoho Mail (official hosted MCP: mcp.zoho.com) ---
ZOHO_EMAIL=
ZOHO_DISPLAY_NAME=Zoho Mail
# Region: in | com | eu | com.au | jp
ZOHO_REGION=in
# Connector URL from mcp.zoho.com (leave blank if not yet created)
ZOHO_MCP_URL=
# Transport for the remote connector: sse | http
ZOHO_MCP_TRANSPORT=sse
# Optional bearer token if your connector issued one
ZOHO_MCP_AUTH_TOKEN=
# ZOHO_ACCOUNT_ID=zoho-primary

# --- Yahoo Mail (IMAP + app password) ---
# Generate an app password per docs/YAHOO-SETUP.md
YAHOO_EMAIL=
YAHOO_APP_PASSWORD=
YAHOO_DISPLAY_NAME=Yahoo Mail
YAHOO_IMAP_HOST=imap.mail.yahoo.com
YAHOO_IMAP_PORT=993
YAHOO_SMTP_HOST=smtp.mail.yahoo.com
YAHOO_SMTP_PORT=465
# Override the launcher if using a different IMAP MCP server:
# YAHOO_MCP_COMMAND=npx
# YAHOO_MCP_ARGS=["-y","imap-mcp-server"]

# LOCAL DEV ONLY: if antivirus (e.g. Avast Mail Shield) intercepts IMAP port 993
# with its own CA, set this to bypass TLS cert validation for the IMAP child ONLY.
# Leave UNSET/false everywhere real (the Macs) so certificate checks stay on.
# IMAP_ALLOW_INSECURE_TLS=false

# --- Outlook Mail (via IMAP + app password; personal Outlook.com/Hotmail) ---
# Personal accounts: enable 2FA, then create an app password. M365 work/school
# accounts often have IMAP basic-auth disabled — use the Graph path below instead.
# OUTLOOK_EMAIL=
# OUTLOOK_APP_PASSWORD=
# OUTLOOK_DISPLAY_NAME=Outlook
# OUTLOOK_IMAP_HOST=outlook.office365.com
# OUTLOOK_IMAP_PORT=993
# OUTLOOK_SMTP_HOST=smtp-mail.outlook.com
# OUTLOOK_SMTP_PORT=587

# --- Outlook via Microsoft Graph (OAuth) — ONLY for M365 accounts with IMAP disabled ---
# Setting either OUTLOOK_GRAPH_MCP_URL or OUTLOOK_GRAPH_MCP_COMMAND switches Outlook
# to the read-only GraphAdapter. Full walkthrough: docs/OUTLOOK-GRAPH-SETUP.md
# OUTLOOK_EMAIL=you@yourcompany.com
# Local stdio Graph MCP server:
# OUTLOOK_GRAPH_MCP_COMMAND=npx
# OUTLOOK_GRAPH_MCP_ARGS=["-y","<your-graph-mcp-server-package>"]
# ...or a remote endpoint:
# OUTLOOK_GRAPH_MCP_URL=https://your-graph-mcp.example.com/mcp
# OUTLOOK_GRAPH_MCP_TRANSPORT=http
# OUTLOOK_GRAPH_AUTH_TOKEN=
# Map logical ops to that server's actual tool names if auto-detection fails:
# OUTLOOK_GRAPH_TOOLMAP={"listEmails":"list-mail-messages","getEmail":"get-mail-message","searchEmails":"search-mail-messages"}

# --- Notifications ---
NOTIFICATIONS_ENABLED=true
NOTIFICATIONS_SOUND=true
NOTIFICATIONS_URGENT_ONLY=false

# --- Scheduling ---
# Up to 3 digest times per day, comma-separated 24h HH:MM
DIGEST_SCHEDULE=09:00,14:00,19:00
TIMEZONE=Asia/Kolkata
# Real-time urgent-email polling in minutes (0 = disabled). Uses API quota when > 0.
URGENT_POLL_MINUTES=0

# --- General ---
# Log level: debug | info | warn | error
LOG_LEVEL=info
# Cache
CACHE_ENABLED=true
CACHE_TTL=300
CACHE_MAX_ENTRIES=2000
